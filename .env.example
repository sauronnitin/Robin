# =============================================================================
# Robin — environment template
# Copy to `.env` and fill in your own keys. Never commit `.env`.
# Settings UI (dashboard sidebar) upserts allowlisted keys into local `.env`
# and non-secret prefs into gitignored `user/settings.json`. APIs never return
# raw secrets (masked set / missing only).
# =============================================================================

# --- LLM keys (required for live runs) ---
GROQ_API_KEY=your_groq_key_here
# Google AI Studio: https://aistudio.google.com/apikey
# Use Gemini Flash only. Do not use gemini-2.5-pro (cost trap).
GEMINI_API_KEY=your_gemini_api_key_here

# --- Google Drive / Sheets (recommended; optional for local-only) ---
# Desktop OAuth client JSON path (GCP Console > APIs & Services > Credentials)
GOOGLE_OAUTH_CLIENT_SECRET=./secrets/google-oauth-client.json

# Google Sheet ID from URL: https://docs.google.com/spreadsheets/d/{THIS_ID}/edit
MASTER_SHEET_ID=your_google_sheet_id_here

# Drive FOLDER id (not a Drive "Project"). Files land here.
# https://drive.google.com/drive/folders/{THIS_ID}
GOOGLE_DRIVE_FOLDER_ID=

# --- Profile ---
# Which profile folder under profiles/ to use (see profiles/README.md)
ROBIN_PROFILE=product-designer

# --- Job API keys (optional - free tiers) ---
# SerpAPI: https://serpapi.com/ (~100 free searches/month, shared).
# Enables Google Jobs in Scout/Browse, and optional Knowledge Graph Market Pulse
# (Google News). Market Pulse is off by default and caches results for 72 hours.
SERPAPI_API_KEY=

# Rise public API: no key required (URL-based, included automatically)
# Remotive / RemoteOK / Jobicy / Freehire: no key required (open APIs)

# --- Runtime ---
LITELLM_DROP_PARAMS=True

# Safety gate: keep True until you intentionally enable real submissions
DRY_RUN=True

# LinkedIn login wall: how long Chrome stays open for manual sign-in (seconds)
JH_LOGIN_WAIT_SECONDS=600

# Optional applicant autofill overrides (used by direct ATS form fill)
# Editable from Settings > Apply autofill (or leave commented / blank)
# APPLICANT_EMAIL=
# APPLICANT_PHONE=
# APPLICANT_FIRST_NAME=
# APPLICANT_LAST_NAME=
# APPLICANT_CITY=
# APPLICANT_STATE=
# Submitted on live applications. Leave unset rather than guessing a country.
# APPLICANT_COUNTRY=
# APPLICANT_LINKEDIN=
# APPLICANT_WEBSITE=
# APPLICANT_WORK_AUTH=yes
# APPLICANT_SPONSORSHIP=no
# APPLICANT_YEARS_EXPERIENCE=
